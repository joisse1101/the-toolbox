{
  "name": "the-toolbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "node scripts/start.ts --build",
    "test": "node --test --import ./test/setup.ts \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p frontend/tsconfig.json && tsc -p test/frontend/tsconfig.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "7.0.2",
    "vite": "^8.3.6"
  }
}
