{
  "name": "the-toolbox",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*",
    "#backend/*": "./backend/*",
    "#frontend/*": "./frontend/*"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "node scripts/start.ts --build",
    "test": "node --test --import ./test/setup.ts \"test/**/*.test.ts\"",
    "lint": "cd .. && eslint -c viewer/eslint.config.mjs viewer toolkit",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.node.json && node node_modules/@typescript/native/bin/tsc -p frontend/tsconfig.json && node node_modules/@typescript/native/bin/tsc -p test/frontend/tsconfig.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-boundaries": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.8"
  }
}
