@startuml sample_sign_in_class
title UC-sign-in - Sign in (Analysis)
' palette: boundary=blue · service=green · domain=amber · repo/port/adapter=lavender · infra=gray

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

rectangle "Identity and access" as IAM {
  class "«boundary»\nSignInForm" as SIGNIN #E6F0FB {
    +submit(email, password)
  }
  class "«boundary»\nResetRequestForm" as RESETFORM #E6F0FB {
    +submit(email)
  }
  class "«service»\nAuthService" as AUTH #E7F4EA {
    +authenticate(email, password) : Member
  }
  class "«service»\nPasswordResetService" as RESET #E7F4EA {
    +requestReset(email)
  }
  class "«root entity»\nMember" as MEMBER #FBF2D9 {
    -email : Email
    -credential : Credential
    +verifyCredential(raw) : bool
  }
  class "«value object»\nEmail" as EMAIL #FBF2D9
  class "«value object»\nCredential" as CRED #FBF2D9
  class "«value object»\nResetLink" as LINK #FBF2D9
  class "«repository»\nMemberRepository" as REPO #EEE7F7 {
    +getByEmail(email) : Member?
  }
  class "«port»\nMailer" as MAILER #EEE7F7 {
    +send(email, link)
  }
}

' ----- Relationships -----
SIGNIN     ..> AUTH   : authenticate
RESETFORM  ..> RESET  : requestReset
AUTH       --> REPO   : getByEmail
RESET      --> REPO   : getByEmail
AUTH       ..> MEMBER : verifyCredential
RESET      ..> LINK   : issue
RESET      --> MAILER : send
MEMBER     ..> EMAIL
MEMBER     ..> CRED
@enduml
