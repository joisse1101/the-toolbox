{
  "claudeMdExcludes": [
    "**/CLAUDE.md",
    "**/.claude/rules/**"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ai/mcp/wait-for-story-tools.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node ai/mcp/guard-read.mjs"
          }
        ]
      }
    ]
  }
}
