+import { describe, expect, it, vi } from 'vitest';
+import { addHabit, emptyState, toggleCheck, today, type State } from './storage';
+import { HABIT_NOT_FOUND, currentStreak } from './streak';
+
+const stateWithChecks = (days: string[]): { state: State; id: string } => {
+  let state = addHabit(emptyState(), 'Read');
+  const id = state.habits[0].id;
+  for (const day of days) state = toggleCheck(state, id, day);
+  return { state, id };
+};
+
+describe('currentStreak', () => {
+  it('returns 3 when the last 3 days are checked', () => {
+    const { state, id } = stateWithChecks(['2026-03-01', '2026-03-02', '2026-03-03']);
+    expect(currentStreak(state, id, '2026-03-03')).toEqual({ ok: true, days: 3 });
+  });
+
+  it('still returns 3 when the run ends yesterday', () => {
+    const { state, id } = stateWithChecks(['2026-03-01', '2026-03-02', '2026-03-03']);
+    expect(currentStreak(state, id, '2026-03-04')).toEqual({ ok: true, days: 3 });
+  });
+
+  it('returns 0 when the last check is older than yesterday', () => {
+    const { state, id } = stateWithChecks(['2026-03-01']);
+    expect(currentStreak(state, id, '2026-03-04')).toEqual({ ok: true, days: 0 });
+  });
+
+  it('counts across a month and year boundary', () => {
+    const { state, id } = stateWithChecks(['2025-12-31', '2026-01-01']);
+    expect(currentStreak(state, id, '2026-01-01')).toEqual({ ok: true, days: 2 });
+  });
+
+  it('returns the error "habit not found" for an unknown habit id', () => {
+    const { state } = stateWithChecks([]);
+    expect(currentStreak(state, 'missing', '2026-03-03')).toEqual({ ok: false, error: HABIT_NOT_FOUND });
+    expect(HABIT_NOT_FOUND).toBe('habit not found');
+  });
+
+  it('counts 1000 checked days in under 100 ms', () => {
+    const start = Date.UTC(2023, 0, 1);
+    const days = Array.from({ length: 1000 }, (_, i) => new Date(start + i * 86_400_000).toISOString().slice(0, 10));
+    const { state, id } = stateWithChecks(days);
+    const lastDay = days[days.length - 1];
+    const before = performance.now();
+    const result = currentStreak(state, id, lastDay);
+    const elapsedMs = performance.now() - before;
+    expect(result).toEqual({ ok: true, days: 1000 });
+    expect(elapsedMs).toBeLessThan(100);
+  });
+});
+
+describe('today (local day)', () => {
+  it('stores a check-off at 23:30 local time under the local date and counts it for that evening', () => {
+    vi.stubEnv('TZ', 'America/Los_Angeles'); // 23:30 here is already the next day in UTC
+    try {
+      const evening = new Date(2026, 2, 3, 23, 30);
+      expect(evening.toISOString().slice(0, 10)).toBe('2026-03-04');
+      const day = today(evening);
+      expect(day).toBe('2026-03-03');
+      const { state, id } = stateWithChecks(['2026-03-01', '2026-03-02', day]);
+      expect(currentStreak(state, id, day)).toEqual({ ok: true, days: 3 });
+    } finally {
+      vi.unstubAllEnvs();
+    }
+  });
+});
diff --git a/app/src/streak.ts b/app/src/streak.ts
new file mode 100644
index 0000000..d8e8548
--- /dev/null
+++ b/app/src/streak.ts
@@ -0,0 +1,30 @@
+// Counts streaks over the checked days of a habit. Pure: no storage, no clock.
+import type { State } from './storage';
+
+export const HABIT_NOT_FOUND = 'habit not found';
+
+export type StreakResult = { ok: true; days: number } | { ok: false; error: typeof HABIT_NOT_FOUND };
+
+// Day arithmetic goes through UTC only to step the calendar; the days themselves are local days (D1).
+const previousDay = (day: string): string => {
+  const [year, month, date] = day.split('-').map(Number);
+  return new Date(Date.UTC(year, month - 1, date - 1)).toISOString().slice(0, 10);
+};
+
+// A run that ends yesterday still counts (D2), so counting starts at yesterday when today is not checked.
+export function countCurrentStreak(checks: string[], today: string): number {
+  const checked = new Set(checks);
+  let day = checked.has(today) ? today : previousDay(today);
+  let days = 0;
+  while (checked.has(day)) {
+    days += 1;
+    day = previousDay(day);
+  }
+  return days;
+}
+
+export function currentStreak(state: State, habitId: string, today: string): StreakResult {
+  const habit = state.habits.find((h) => h.id === habitId);
+  if (!habit) return { ok: false, error: HABIT_NOT_FOUND };
+  return { ok: true, days: countCurrentStreak(habit.checks, today) };
+}
