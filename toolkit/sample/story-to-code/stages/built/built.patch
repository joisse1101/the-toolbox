+// The longest run of consecutive days among the checked days (D1).
+export function countBestStreak(checks: string[]): number {
+  const days = [...new Set(checks)].sort();
+  let best = 0;
+  let run = 0;
+  days.forEach((day, index) => {
+    run = index > 0 && previousDay(day) === days[index - 1] ? run + 1 : 1;
+    best = Math.max(best, run);
+  });
+  return best;
+}
+
+export function bestStreak(state: State, store: Store, habitId: string): StreakResult {
+  const habit = state.habits.find((h) => h.id === habitId);
+  if (!habit) return { ok: false, error: HABIT_NOT_FOUND };
+  const days = countBestStreak(habit.checks);
+  saveBestStreak(store, habitId, days);
+  return { ok: true, days };
+}
+
 export function currentStreak(state: State, habitId: string, today: string): StreakResult {
   const habit = state.habits.find((h) => h.id === habitId);
   if (!habit) return { ok: false, error: HABIT_NOT_FOUND };
