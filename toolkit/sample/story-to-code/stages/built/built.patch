Subject: [PATCH 1/4] feat(streaks): add the current streak count

---
 app/src/storage.test.ts | 22 +++++++++++++++++++++-
 app/src/storage.ts      | 16 ++++++++++++++++
 2 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/app/src/storage.test.ts b/app/src/storage.test.ts
index 2f98980..ebc9b02 100644
--- a/app/src/storage.test.ts
+++ b/app/src/storage.test.ts
@@ -1,5 +1,5 @@
 import { describe, expect, it } from 'vitest';
-import { addHabit, emptyState, loadState, saveState, toggleCheck, type Store } from './storage';
+import { addHabit, currentStreak, emptyState, loadState, saveState, toggleCheck, type Store } from './storage';
 
 const fakeStore = (): Store => {
   const data = new Map<string, string>();
@@ -15,3 +15,23 @@ describe('storage', () => {
     expect(loadState(store).habits[0].checks).toEqual(['2026-01-05']);
   });
 });
+
+describe('currentStreak', () => {
+  const lastThreeDays = ['2026-11-18', '2026-11-19', '2026-11-20'];
+
+  it('returns 3 when the last 3 days ending today are checked', () => {
+    expect(currentStreak(lastThreeDays, '2026-11-20')).toBe(3);
+  });
+
+  it('returns 3 when the run ends yesterday and today is not checked yet', () => {
+    expect(currentStreak(lastThreeDays, '2026-11-21')).toBe(3);
+  });
+
+  it('returns 0 when the run ended before yesterday', () => {
+    expect(currentStreak(lastThreeDays, '2026-11-22')).toBe(0);
+  });
+
+  it('returns 0 for an empty list', () => {
+    expect(currentStreak([], '2026-11-20')).toBe(0);
+  });
+});
diff --git a/app/src/storage.ts b/app/src/storage.ts
index 7097886..5077d6e 100644
--- a/app/src/storage.ts
+++ b/app/src/storage.ts
@@ -41,6 +41,22 @@ export function saveState(store: Store, state: State): void {
 
 export const today = (now = new Date()): string => now.toISOString().slice(0, 10);
 
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+const dayBefore = (day: string): string => new Date(Date.parse(day) - MS_PER_DAY).toISOString().slice(0, 10);
+
+// Days in a row that end today, or end yesterday when today is not checked yet.
+export function currentStreak(checks: string[], todayDay: string): number {
+  const days = new Set(checks);
+  let day = days.has(todayDay) ? todayDay : dayBefore(todayDay);
+  let count = 0;
+  while (days.has(day)) {
+    count += 1;
+    day = dayBefore(day);
+  }
+  return count;
+}
+
 export function addHabit(state: State, name: string): State {
   const trimmed = name.trim();
   if (!trimmed) return state;
-- 
