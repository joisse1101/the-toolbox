diff --git a/app/src/storage.ts b/app/src/storage.ts
index 5077d6e..a49107d 100644
--- a/app/src/storage.ts
+++ b/app/src/storage.ts
@@ -57,6 +57,18 @@ export function currentStreak(checks: string[], todayDay: string): number {
   return count;
 }
 
+// Length of the longest run of consecutive days in checks.
+export function bestStreak(checks: string[]): number {
+  const days = [...new Set(checks)].sort();
+  let best = 0;
+  let run = 0;
+  days.forEach((day, i) => {
+    run = i > 0 && dayBefore(day) === days[i - 1] ? run + 1 : 1;
+    best = Math.max(best, run);
+  });
+  return best;
+}
