+++ b/app/src/streak.ts
@@ -0,0 +1,18 @@
+// Streaks: runs of consecutive days a habit was checked off. Days are YYYY-MM-DD strings.
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+const dayNumber = (day: string): number => Math.floor(Date.parse(`${day}T00:00:00Z`) / DAY_MS);
+
+// The run of consecutive days that ends today, or yesterday when today is not checked yet.
+export function currentStreak(checks: string[], today: string): number {
+  const days = new Set(checks.map(dayNumber));
+  let day = dayNumber(today);
+  if (!days.has(day)) day -= 1;
+  let run = 0;
+  while (days.has(day)) {
+    run += 1;
+    day -= 1;
+  }
+  return run;
+}
