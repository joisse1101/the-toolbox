+// The longest run of consecutive days among the check-offs.
+export function bestStreak(checks: string[]): number {
+  const days = [...new Set(checks.map(dayNumber))].sort((a, b) => a - b);
+  let best = 0;
+  let run = 0;
+  days.forEach((day, i) => {
+    run = i > 0 && day === days[i - 1] + 1 ? run + 1 : 1;
+    best = Math.max(best, run);
+  });
+  return best;
+}
